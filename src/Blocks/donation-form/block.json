{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "famehelsinki/donation-form",
	"version": "0.1.0",
	"title": "Lahjoitin",
	"category": "widgets",
	"description": "Gutenberg block for Fame donation system.",
	"example": {},
	"attributes": {
		"layoutVersion": { "type": "number", "default": 0 },
		"formWidth": {
			"type": "string",
			"enum": ["", "content", "custom"],
			"default": ""
		},
		"formMaxWidth": { "type": "integer", "default": 0 },
		"colsDesktop": {
			"type": "number",
			"default": 1
		},
		"returnAddress": {
			"type": "string",
			"default": "/"
		},
		"primaryColor": {
			"type": "string",
			"default": "#000000"
		},
		"secondaryColor": {
			"type": "string",
			"default": "#FFFFFF"
		},
		"buttonBorderColor": {
			"type": "string",
			"default": ""
		},
		"thirdColor": {
			"type": "string",
			"default": "#444"
		},
		"textFieldBorderRadius": {
			"type": "string",
			"default": "0px"
		},
		"borderRadius": {
			"type": "string",
			"default": "0px"
		},
		"borderWidth": {
			"type": "string",
			"default": "1px"
		},
		"dangerColor": {
			"type": "string",
			"default": "#dc3545"
		},
		"sectionLabelFontWeight": {
			"type": "string",
			"default": ""
		},
		"sectionLabelColor": {
			"type": "string",
			"default": ""
		},
		"sectionLabelFontSize": {
			"type": "string",
			"default": "1.25em"
		}
	},
	"supports": {
		"align": ["left", "right", "center", "wide", "full"],
		"color": {
			"background": true,
			"text": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalDefaultControls": {
				"margin": true,
				"padding": true
			}
		},
		"html": false,
		"typography": {
			"fontSize": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalDefaultControls": {
				"color": true,
				"radius": true,
				"style": true,
				"width": true
			}
		}
	},
	"allowedBlocks": ["core/columns"],
	"icon": "money",
	"textdomain": "fame_lahjoitukset",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"viewScript": "file:./view.js",
	"style": "file:./view.css",
	"render": "file:./render.php"
}
